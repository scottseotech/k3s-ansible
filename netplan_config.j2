network:
  version: 2
  ethernets:
    eth0:
      match:
        macaddress: {{ mac_address }} 
      set-name: eth0
      dhcp4: false
      mtu: 9000
      addresses:
        - {{ static_ip }}/24
      routes:
        - to: default
          via: {{ gateway }}
      nameservers:
        addresses: {{ dns_servers }}